---
import '@/styles/global.css'

interface Props {
  title: string
  description?: string
  noindex?: boolean
}

const {
  title,
  description = 'YIMBY Adelaide supports abundant, affordable, well-located housing.',
  noindex = false
} = Astro.props
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`
const withBase = (path: string) => path === '/' ? base : `${base}${path.replace(/^\//, '')}`
const navigation = [
  {label: 'Home', href: withBase('/')},
  {label: 'About', href: withBase('/about')},
  {label: 'Membership', href: withBase('/membership')},
  {label: 'Events', href: withBase('/events')},
  {label: 'Contact', href: withBase('/contact')}
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2PFXG3X8PL"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-2PFXG3X8PL');
    </script>
    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1006874445282912');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1006874445282912&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body style={`--skyline-image: url("${withBase('/adelaide-skyline-banner.jfif')}")`}>
    <header class="site-header">
      <a class="brand" href={withBase('/')} aria-label="YIMBY Adelaide home">
        <img src={withBase('/yimby-adelaide-logo.png')} alt="" />
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="header-cta" href={withBase('/membership')}>Join</a>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <img src={withBase('/yimby-adelaide-logo.png')} alt="YIMBY Adelaide" />
        <p>More homes, better choices, a fairer Adelaide.</p>
      </div>
      <nav aria-label="Footer navigation">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </footer>
  </body>
</html>
