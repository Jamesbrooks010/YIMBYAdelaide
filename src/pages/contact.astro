---
import BaseLayout from '@/layouts/BaseLayout.astro'
import SignupForm from '@/components/SignupForm.astro'

const contactEmail = 'info@yimbyadelaide.com'
const contactFormEndpoint = `https://formsubmit.co/ajax/${contactEmail}`
---

<BaseLayout
  title="Contact | YIMBY Adelaide"
  description="Contact YIMBY Adelaide, join the supporter list, or send a message."
>
  <main>
    <section class="page-hero page-hero--contact">
      <p class="eyebrow">Contact</p>
      <h1>Talk to us about housing in Adelaide.</h1>
      <p>
        Send a message, join the supporter list, or get in touch about campaigns, media,
        volunteering, and local planning issues.
      </p>
    </section>

    <section class="section contact-grid">
      <form
        class="contact-form"
        id="contact-message-form"
        action={contactFormEndpoint}
        method="post"
      >
        <input type="hidden" name="_subject" value="New message from YIMBY Adelaide website" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <label class="contact-form__honeypot" aria-hidden="true">
          <span>Website</span>
          <input name="_honey" type="text" tabindex="-1" autocomplete="off" />
        </label>
        <label>
          <span>Name</span>
          <input name="name" type="text" autocomplete="name" required />
        </label>
        <label>
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          <span>Message</span>
          <textarea name="message" rows="7" required></textarea>
        </label>
        <button type="submit" data-contact-submit>Send message</button>
        <p class="contact-form__status" data-contact-status aria-live="polite"></p>
      </form>

      <aside class="contact-aside">
        <div>
          <p class="eyebrow">Email</p>
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </div>
        <div>
          <p class="eyebrow">Supporter Updates</p>
          <SignupForm compact />
        </div>
      </aside>
    </section>
  </main>

  <script>
    const contactForm = document.querySelector('#contact-message-form')
    const contactStatus = document.querySelector('[data-contact-status]')
    const contactSubmit = document.querySelector('[data-contact-submit]')

    contactForm?.addEventListener('submit', async (event) => {
      event.preventDefault()

      if (!(contactForm instanceof HTMLFormElement) || !contactForm.reportValidity()) {
        return
      }

      const formData = new FormData(contactForm)

      if (contactStatus) {
        contactStatus.textContent = 'Sending your message...'
      }

      if (contactSubmit instanceof HTMLButtonElement) {
        contactSubmit.disabled = true
      }

      try {
        const response = await fetch(contactForm.action, {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json'
          }
        })

        if (!response.ok) {
          throw new Error('Contact form submission failed')
        }

        contactForm.reset()

        if (contactStatus) {
          contactStatus.textContent = 'Thanks, your message has been sent.'
        }
      } catch {
        if (contactStatus) {
          contactStatus.textContent =
            'Sorry, something went wrong. Please email info@yimbyadelaide.com directly.'
        }
      } finally {
        if (contactSubmit instanceof HTMLButtonElement) {
          contactSubmit.disabled = false
        }
      }
    })
  </script>
</BaseLayout>
