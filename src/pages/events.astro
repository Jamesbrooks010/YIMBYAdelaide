---
import BaseLayout from '@/layouts/BaseLayout.astro'

---

<BaseLayout
  title="Events | YIMBY Adelaide"
  description="Find upcoming YIMBY Adelaide events and join Adelaide's pro-housing community in person."
>
  <main>
    <section class="page-hero page-hero--contact">
      <p class="eyebrow">Next Event</p>
      <h1>Join us at our next event</h1>
      <p>
        Join YIMBY Adelaide for Wasted Space: Car Parking in Adelaide with Dom Betherens.
        View the event details and RSVP through Action Network.
      </p>
    </section>

    <section class="briefing-feature" aria-labelledby="featured-event-heading">
      <div class="event-icon event-icon--parking" aria-hidden="true">
        <svg viewBox="0 0 48 48" focusable="false">
          <rect x="9" y="6" width="30" height="36" rx="4" />
          <path d="M20 35V14h7a7 7 0 0 1 0 14h-7m0-7h7" />
        </svg>
      </div>
      <div>
        <p class="eyebrow">Next Event</p>
        <h2 id="featured-event-heading">Wasted Space: Car Parking in Adelaide</h2>
        <p class="briefing-feature__byline">With Dom Betherens.</p>
        <div class="action-network-event">
          <link href="https://actionnetwork.org/css/style-embed-v3.css" rel="stylesheet" type="text/css" />
          <script is:inline src="https://actionnetwork.org/widgets/v6/event/wasted-space-car-parking-in-adelaide-with-dom-betherens?format=js&source=widget"></script>
          <div id="can-event-area-wasted-space-car-parking-in-adelaide-with-dom-betherens" style="width: 100%">
            <!-- Action Network inserts the embedded event here. -->
          </div>
        </div>
      </div>
    </section>

    <section class="parking-preview" aria-labelledby="completed-event-heading">
      <div class="event-icon event-icon--screen" aria-hidden="true">
        <svg viewBox="0 0 48 48" focusable="false">
          <rect x="8" y="10" width="32" height="23" rx="2" />
          <path d="M19 40h10m-5-7v7M13 16h22" />
        </svg>
      </div>
      <div>
        <p class="eyebrow">Completed Event</p>
        <h2 id="completed-event-heading">YIMBY Adelaide Zoning Atlas Briefing</h2>
        <p>Presented by YIMBY Melbourne.</p>
        <span>Event completed</span>
      </div>
    </section>

    <aside class="events-more" aria-label="More YIMBY Adelaide links">
      <p>
        Looking for more ways to connect?
        <a href="https://linktr.ee/yimbyadelaide" target="_blank" rel="noopener noreferrer">
          Visit YIMBY Adelaide on Linktree <span aria-hidden="true">↗</span>
        </a>
      </p>
    </aside>
  </main>
</BaseLayout>
