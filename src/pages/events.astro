---
import BaseLayout from '@/layouts/BaseLayout.astro'

---

<BaseLayout
  title="Events | YIMBY Adelaide"
  description="Find upcoming YIMBY Adelaide events and join Adelaide's pro-housing community in person."
>
  <main>
    <section class="page-hero page-hero--contact">
      <p class="eyebrow">Next Event</p>
      <h1>Join us at our next event</h1>
      <p>
        Join YIMBY Adelaide for our final Knock-Off / Happy Hour drinks of 2026
        at the Havelock Hotel. View the details below and RSVP through Action Network.
      </p>
    </section>

    <section class="briefing-feature" aria-labelledby="featured-event-heading">
      <div class="event-icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" focusable="false">
          <path d="M12 8h24l-3 17a9 9 0 0 1-18 0L12 8Zm12 26v8m-7 0h14M14 18h20" />
        </svg>
      </div>
      <div>
        <p class="eyebrow">Next Event</p>
        <h2 id="featured-event-heading">Final Knock-Off / Happy Hour Drinks</h2>
        <p class="briefing-feature__byline">Friday 27 November 2026, 5:30 pm.</p>
        <p>Havelock Hotel (General Havelock), 162 Hutt Street, Adelaide.</p>
        <p>Wrap up the year with food, drinks, and a chat about more homes for Adelaide.
          Bring your friends and your ideas — everyone is welcome.</p>
        <a class="button" href="https://actionnetwork.org/events/yimby-adelaide-november-knock-off-drinks" target="_blank" rel="noopener noreferrer">RSVP on Action Network</a>
      </div>
    </section>

    <section class="parking-preview" aria-labelledby="completed-parking-heading">
      <div class="event-icon event-icon--parking" aria-hidden="true">
        <svg viewBox="0 0 48 48" focusable="false">
          <rect x="9" y="6" width="30" height="36" rx="4" />
          <path d="M20 35V14h7a7 7 0 0 1 0 14h-7m0-7h7" />
        </svg>
      </div>
      <div>
        <p class="eyebrow">Completed Event</p>
        <h2 id="completed-parking-heading">Wasted Space: Car Parking in Adelaide</h2>
        <p>With Dominic Behrens. Friday 16 October 2026.</p>
        <span>Event completed</span>
      </div>
    </section>

    <section class="parking-preview" aria-labelledby="completed-event-heading">
      <div class="event-icon event-icon--screen" aria-hidden="true">
        <svg viewBox="0 0 48 48" focusable="false">
          <rect x="8" y="10" width="32" height="23" rx="2" />
          <path d="M19 40h10m-5-7v7M13 16h22" />
        </svg>
      </div>
      <div>
        <p class="eyebrow">Completed Event</p>
        <h2 id="completed-event-heading">YIMBY Adelaide Zoning Atlas Briefing</h2>
        <p>Presented by YIMBY Melbourne.</p>
        <span>Event completed</span>
      </div>
    </section>

    <aside class="events-more" aria-label="More YIMBY Adelaide links">
      <p>
        Looking for more ways to connect?
        <a href="https://linktr.ee/yimbyadelaide" target="_blank" rel="noopener noreferrer">
          Visit YIMBY Adelaide on Linktree <span aria-hidden="true">↗</span>
        </a>
      </p>
    </aside>
  </main>
</BaseLayout>
